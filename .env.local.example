# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic (AI 답변 초안 생성 — 서버 전용)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Kakao
NEXT_PUBLIC_KAKAO_MAP_API_KEY=your-kakao-map-key
NEXT_PUBLIC_KAKAO_CHANNEL_PUBLIC_ID=your-channel-id

# Email (for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@kizmeal.com
SMTP_PASS=your-smtp-password
CONTACT_TO_EMAIL=hello@kizmeal.com

# 공휴일 수집 — data.go.kr 한국천문연구원 특일 정보 (서버 전용)
#  ⚠️ 반드시 "일반 인증키(Decoding)" = 원본 키를 넣을 것.
#     Encoding 키를 넣으면 URLSearchParams가 한 번 더 인코딩해
#     (%2B → %252B) SERVICE_KEY_IS_NOT_REGISTERED_ERROR가 난다.
#  ⚠️ GitHub Actions Secrets에는 넣지 않는다 — gen_form.py는 이 API를
#     직접 호출하지 않고 public_holidays 테이블을 읽는다.
DATA_GO_KR_SERVICE_KEY=your-decoding-service-key

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
